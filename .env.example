# Copy this file to .env on the production host.
# Do not commit .env or share the generated secret.

# Public DNS name pointing to your VPS.
NEXORA_DOMAIN=app.example.com

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Replace this placeholder before starting the production backend.
NEXORA_SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Session lifetime in hours (backend clamps this to its supported range).
NEXORA_SESSION_HOURS=12

# Used only for local development outside Docker.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
